{
  "name": "vidyatrack",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "scripts": {
    "api": "npm run start:dev --workspace=apps/api",
    "web": "npm run dev --workspace=apps/web",
    "api:build": "npm run build --workspace=apps/api",
    "web:build": "npm run build --workspace=apps/web",
    "db:migrate": "npm run migration:run --workspace=apps/api",
    "db:seed": "npm run seed --workspace=apps/api",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
