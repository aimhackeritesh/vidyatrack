# Runtime: least-privilege role (NOSUPERUSER/NOBYPASSRLS) so Postgres RLS is enforced.
DATABASE_URL=postgresql://vidyatrack_app:vidyatrack_app@localhost:5432/vidyatrack
# Admin: superuser used by `npm run seed` and migrations (bypasses RLS).
DATABASE_ADMIN_URL=postgresql://vidyatrack:vidyatrack@localhost:5432/vidyatrack
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me_in_production_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_min_32_chars_long
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
OTP_EXPIRE_SECONDS=300
OTP_MAX_PER_HOUR=5
PORT=3000
NODE_ENV=development

# SMS provider (MSG91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=VDYTRK

# Firebase FCM
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# S3 / Cloudflare R2
S3_BUCKET=vidyatrack
S3_REGION=ap-south-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=

# App
APP_URL=http://localhost:3000
SUPER_ADMIN_PHONE=9999999999
