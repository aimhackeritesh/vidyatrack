# ─────────────────────────────────────────────────────────────────────────────
# VidyaTrack API — PRODUCTION environment template.
# Copy the values into your host's env-var UI (Railway service variables).
# NEVER commit real secrets. Generate fresh JWT secrets — do NOT reuse dev ones.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime connection — the least-privilege app role (RLS enforced).
# On Railway: create the vidyatrack_app role via `npm run db:apply`, then point
# this at it. Format: postgresql://vidyatrack_app:<password>@<host>:<port>/<db>
DATABASE_URL=postgresql://vidyatrack_app:CHANGE_ME@<pg-host>:5432/railway

# Admin/superuser connection — used only by db:apply + bootstrap:prod (one-off).
# On Railway this is the default connection string it gives you.
DATABASE_ADMIN_URL=postgresql://postgres:CHANGE_ME@<pg-host>:5432/railway

# Redis (OTP store, BullMQ, sessions). Railway Redis plugin gives this.
REDIS_URL=redis://default:CHANGE_ME@<redis-host>:6379

# Auth — generate with e.g. `openssl rand -hex 32`. Must be ≥32 chars, unique.
JWT_SECRET=CHANGE_ME_generate_a_fresh_64_hex_secret
JWT_REFRESH_SECRET=CHANGE_ME_generate_a_different_64_hex_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRE_SECONDS=300
OTP_MAX_PER_HOUR=5

PORT=3000
NODE_ENV=production

# Lock CORS to the deployed web console origin (no trailing slash).
# e.g. https://vidyatrack-web.vercel.app
CORS_ORIGIN=https://<your-web-domain>

# Public base URL of THIS api (used to build absolute upload URLs).
APP_URL=https://<your-api-domain>

# One-time super-admin bootstrap (used by `npm run bootstrap:prod`).
SUPER_ADMIN_EMAIL=founder@vidyatrack.in
SUPER_ADMIN_PASSWORD=CHANGE_ME_strong_password
SUPER_ADMIN_NAME=Platform Owner

# File storage: local (ephemeral on container hosts — V1) or s3 (post-V1).
STORAGE_MODE=local

# ── Deferred / not used in V1 (leave blank) ─────────────────────────────────
# SMS OTP is not wired in V1 (password login only). Fill these when adding it.
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=VDYTRK
# FCM push — deferred.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# S3/R2 durable uploads — deferred.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
